{
  "$schema": "https://raw.githubusercontent.com/nicoache/tauri/refs/heads/v2/packages/api/schema.json",
  "productName": "ESTA Profile Generator",
  "version": "0.1.0",
  "identifier": "com.esta.esta-profile-gui",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ESTA Profile Generator",
        "width": 1000,
        "height": 780
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
